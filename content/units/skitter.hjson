// skitter.hjson
//
// Task 3.1: defines the "Skitter" enemy unit type.
//
// CONFIRMED field names: fetched directly from the official Mindustry
// wiki's UnitType field reference (not guessed/inferred) - speed,
// hitSize, health, armor, drag, accel, rotateSpeed, flying,
// targetGround, targetAir, faceTarget, itemCapacity are all real
// UnitType fields with the types/defaults shown there.
//
// CONFIRMED via in-game error: the top-level "type" field is NOT a raw
// Java class name. It must be one of exactly:
// flying/mech/legs/naval/payload/missile/tether/crawl.
// Using "UnitType" (my original guess) threw:
// [IllegalArgument] Invalid unit type: 'UnitType'.
// Went with "crawl" as the simplest ground-movement type, closest to
// vanilla Dagger's plain sliding movement - no articulated legs, so no
// extra leg-sprite requirement to guess at on top of an already-broken
// load. "legs" is also valid and arguably a better thematic fit for a
// unit named "Skitter" (visible walking legs) - worth revisiting as a
// follow-up once "crawl" is confirmed loading cleanly, since legs
// likely needs its own sprite naming convention not yet confirmed.
//
// CONFIRMED via in-game load: the mod loads successfully (only a
// non-fatal warning about the "range" field, since removed - see the
// weapon block below), meaning: the weapon/bullet block's polymorphic
// "type: BasicBulletType" syntax is valid, and both placeholder sprites
// (sprites/units/skitter.png, sprites/units/skitter-cell.png) are
// sufficient for load - no sprite-related error occurred. Spawn logic
// from Phase 2 is confirmed still firing correctly on top of this
// (console showed real "spawn triggered near noise source" messages).
//
// STILL NOT CONFIRMED - this only proves the mod LOADS, not that the
// unit behaves/looks right in practice. Once Task 3.2 actually spawns
// one, still worth checking: does it move at a reasonable speed, does
// the weapon actually fire and hit things, does the placeholder sprite
// look reasonable at actual in-game zoom (vs. real art later).
//
// Design intent per the implementation plan: "weak-but-numerous" -
// encourages turret defense over raw stat checks. Values below are
// deliberately low and are placeholders pending Task 5.2 balance passes,
// same as the noise-tracker tier values.

type: crawl

// --- Movement (confirmed fields) ---
speed: 0.5
accel: 0.4
drag: 0.35
rotateSpeed: 6
hitSize: 7

// --- Combat stats (confirmed fields) ---
health: 35
armor: 0

// --- Behavior flags (confirmed fields) ---
flying: false
targetGround: true
targetAir: false
faceTarget: true
itemCapacity: 0

// --- Weapon ---
// CONFIRMED via in-game warning: "range" is not a real field on Weapon
// ([W] Unknown Field 'range' for class 'Weapon' - warning, not fatal,
// mod still loaded). Removed it - effective attack range comes from the
// bullet's speed * lifetime instead, not a separate weapon-level field.
// Every other field here (name, x, y, reload, top, bullet) produced no
// warning, so those are confirmed valid as written.
weapons: [
  {
    name: "skitter-mouth"
    x: 0
    y: 0
    reload: 50
    top: false
    bullet: {
      type: BasicBulletType
      damage: 3
      speed: 3.5
      lifetime: 12
      width: 3
      height: 5
    }
  }
]
